# IC Memo Workbench local runtime
#
# Copy this file to .env. Every key is optional: without OPENAI_API_KEY memos use the
# deterministic template, and without FRED_API_KEY the risk-free rate uses
# RF_FALLBACK_ANNUAL. Never commit .env.

# For running the API or tests on the host. docker-compose.yml overrides this inside
# containers with the postgres service host (postgres:5432).
DATABASE_URL=postgresql+psycopg://allocator:allocator@localhost:5432/allocator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
FRED_API_KEY=
RF_FALLBACK_ANNUAL=0.04
